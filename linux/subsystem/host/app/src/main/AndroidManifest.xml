<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="org.matonos.permission.INSTALL_LINUX_APPS"
        android:protectionLevel="signature|privileged" />
    <permission android:name="org.matonos.permission.QUERY_LINUX_APPS"
        android:protectionLevel="normal" />
    <permission android:name="org.matonos.permission.READ_ICON_THEMES"
        android:protectionLevel="signature" />
    <permission android:name="org.matonos.permission.SET_ICON_THEME"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Provider choices can arrive after read-only network planning, when the store
         is no longer foreground. Only the subsystem-owned confirmation UI uses this. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <intent><action android:name="flatpak.PACKAGE" /></intent>
        <!-- Minimal extra-data stubs have no launcher yet; the subsystem binds this service. -->
        <intent><action android:name="org.matonos.linuxhost.EXTRA_DATA_INSTALL" /></intent>
        <intent><action android:name="org.matonos.dbus.SERVICE" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:name=".LinkStoreStartup" android:label="Linux Subsystem" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:multiArch="true" android:extractNativeLibs="true" android:allowClearUserData="false">
        <provider android:name=".PortalFiles" android:authorities="org.matonos.linux.portal.files"
            android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".IconThemesProvider" android:authorities="org.matonos.linux.icons"
            android:exported="true" android:readPermission="org.matonos.permission.READ_ICON_THEMES" />
        <activity android:name=".WindowActivity" android:exported="false" android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />
        <activity android:name=".ConfirmInstallActivity" android:exported="false" />
        <activity android:name=".stub.StubActivity" android:exported="true" />
        <activity android:name=".stub.InstallActivity" android:exported="true" />
        <service android:name=".stub.StubService" android:exported="false" />
        <service android:name=".LinuxAppStoreService" android:exported="true"
            android:foregroundServiceType="dataSync" />
        <service android:name=".LinuxAppStoreService$CleanupJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".LinuxAppStoreService$BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Same component name as the bootstrap so PackageInstaller can report
             the result after the bootstrap APK has been replaced. -->
        <receiver android:name=".bootstrap.BootstrapResultReceiver" android:exported="false" />
        <!-- Internal support UI; Linux apps have their own launcher entries. -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".DebugExtraInstallActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="false" />
        <!-- Stubs wait on this before their first EROFS mount (pin set after boot). -->
        <activity android:name=".ErofsPinActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true" />
    </application>
</manifest>
