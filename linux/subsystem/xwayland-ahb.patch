+/* A sync_file signalled when all GL work submitted so far completes. */
+static int gl_fence_fd(struct xwl_screen *s) {
+    EGLSyncKHR sync = eglCreateSyncKHR(s->egl_display, EGL_SYNC_NATIVE_FENCE_ANDROID, NULL);
+    if (sync == EGL_NO_SYNC_KHR) {
+        ErrorF("maton-ahb: native fence sync create failed egl=%#x\n", eglGetError());
+        return -1;
+    }
+    glFlush(); /* the fence fd exists once the fence is flushed */
+    int fd = eglDupNativeFenceFDANDROID(s->egl_display, sync);
+    if (fd < 0) ErrorF("maton-ahb: native fence dup failed egl=%#x\n", eglGetError());
+    eglDestroySyncKHR(s->egl_display, sync);
+    return fd;
+}
+/* Add all GL work submitted so far as a write fence to every buffer shared
+ * over DRI3, so readers in other processes wait for it. Runs before any byte
+ * reaches a client (FlushCallback) and before an X sync fence triggers: DRI3
+ * orders our rendering before both, and EXPORT_SYNC_FILE only sees fences
+ * already installed. */
+static void publish_fences(ScreenPtr screen) {
+    struct xwl_screen *s = xwl_screen_get(screen);
+    struct ahb_screen *a = get_ahb(s);
+    struct xwl_pixmap *x;
+    if (xorg_list_is_empty(&a->exports)) return;
+    xwl_glamor_egl_make_current(s);
+    int fence = gl_fence_fd(s);
+    if (fence < 0) return;
+    xorg_list_for_each_entry(x, &a->exports, export_link) {
+        struct dma_buf_import_sync_file imp = { .flags = DMA_BUF_SYNC_WRITE, .fd = fence };
+        if (x->sync_failed || !ioctl(x->export_fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &imp)) continue;
+        /* DRI3 buffers are dma-bufs; one that is not cannot be synchronised. */
+        ErrorF("maton-ahb: dma-buf write fence import failed ino=%lu errno=%d; readers of it are unsynchronised\n",
+               (unsigned long) x->ino, errno);
+        x->sync_failed = TRUE;
+    }
+    MATON_CLOSE(fence);
+}
+static void flush_callback(CallbackListPtr *list, void *screen, void *client) {
+    publish_fences(screen);
+}
+/* X sync fences (DRI3 xshmfence, Present idle) let clients reuse or read a
+ * buffer without a reply on the socket. */
+static DevPrivateKeyRec fence_key;
+static void fence_set_triggered(SyncFence *fence) {
+    SyncFenceSetTriggeredFunc *next = dixLookupPrivate(&fence->devPrivates, &fence_key);
+    publish_fences(fence->pScreen);
+    fence->funcs.SetTriggered = *next;
+    fence->funcs.SetTriggered(fence);
+    *next = fence->funcs.SetTriggered;
+    fence->funcs.SetTriggered = fence_set_triggered;
+}
+static void create_fence(ScreenPtr screen, SyncFence *fence, Bool initially_triggered) {
+    struct ahb_screen *a = dixLookupPrivate(&screen->devPrivates, &ahb_key);
+    SyncScreenFuncsPtr funcs = miSyncGetScreenFuncs(screen);
+    funcs->CreateFence = a->create_fence;
+    funcs->CreateFence(screen, fence, initially_triggered);
+    a->create_fence = funcs->CreateFence;
+    funcs->CreateFence = create_fence;
+    *(SyncFenceSetTriggeredFunc *) dixLookupPrivate(&fence->devPrivates, &fence_key) = fence->funcs.SetTriggered;
+    fence->funcs.SetTriggered = fence_set_triggered;
+}
