+/* Takes the received/allocation reference on success only. */
+static PixmapPtr import_ahb(ScreenPtr screen, AHardwareBuffer *ahb, int depth) {
+    struct xwl_screen *s = xwl_screen_get(screen);
+    AHardwareBuffer_Desc d;
+    AHardwareBuffer_describe(ahb, &d);
+    PixmapPtr p = glamor_create_pixmap(screen, d.width, d.height, depth,
+                                      GLAMOR_CREATE_PIXMAP_NO_TEXTURE);
+    struct xwl_pixmap *a = calloc(1, sizeof(*a));
+    GLuint texture = 0;
+    if (!p || !a) { ErrorF("maton-ahb: import pixmap/alloc failed\n"); goto fail; }
+    xwl_glamor_egl_make_current(s);
+    const EGLint attrs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+    a->image = eglCreateImageKHR(s->egl_display, EGL_NO_CONTEXT,
+        EGL_NATIVE_BUFFER_ANDROID, eglGetNativeClientBufferANDROID(ahb), attrs);
+    if (a->image == EGL_NO_IMAGE_KHR) { ErrorF("maton-ahb: eglCreateImage failed %#x\n", eglGetError()); goto fail; }
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    while (glGetError() != GL_NO_ERROR) {} /* only judge the import below */
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, a->image);
+    GLenum ge = glGetError();
+    if (ge != GL_NO_ERROR || !glamor_set_pixmap_texture(p, texture)) { ErrorF("maton-ahb: texture import failed gl=%#x\n", ge); goto fail; }
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glamor_set_pixmap_type(p, GLAMOR_TEXTURE_DRM);
+    a->ahb = ahb;
+    a->export_fd = -1;
+    xorg_list_init(&a->export_link);
+    xwl_pixmap_set_private(p, a);
+    return p;
+fail:
+    if (texture) glDeleteTextures(1, &texture);
+    if (a && a->image != EGL_NO_IMAGE_KHR) eglDestroyImageKHR(s->egl_display, a->image);
+    free(a);
+    if (p) glamor_destroy_pixmap(p);
+    return NULL;
+}
+static PixmapPtr create_pixmap(ScreenPtr screen, int w, int h, int depth, unsigned hint) {
+    if (w > 0 && h > 0 && (depth == 24 || depth == 32) &&
+        (hint == CREATE_PIXMAP_USAGE_BACKING_PIXMAP || hint == CREATE_PIXMAP_USAGE_SHARED ||
+         (xwl_screen_get(screen)->rootless && hint == 0))) {
+        /* BGRA (HAL 5, not in the NDK enum): X depth 24/32 visuals are
+         * 0x00RRGGBB little-endian, so DRI3 clients see the X byte order.
+         * Depth 24 makes alpha opaque at the X rendering/compositing layer. */
+        AHardwareBuffer_Desc d = { .width=w, .height=h, .layers=1,
+            .format=5u,
+            .usage=AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT };
+        AHardwareBuffer *ahb = NULL;
+        if (AHardwareBuffer_allocate(&d, &ahb)) return NULL;
+        PixmapPtr p = import_ahb(screen, ahb, depth);
+        if (!p) AHardwareBuffer_release(ahb);
+        else if (hint == CREATE_PIXMAP_USAGE_BACKING_PIXMAP) glamor_clear_pixmap(p);
+        return p;
+    }
+    return glamor_create_pixmap(screen, w, h, depth, hint);
+}
+PixmapPtr xwl_glamor_create_pixmap_for_window(struct xwl_window *w) {
+    WindowPtr p = w->surface_window;
+    if (!w->xwl_screen->glamor) return NullPixmap;
+    return create_pixmap(p->drawable.pScreen, p->drawable.width + 2*p->borderWidth,
+        p->drawable.height + 2*p->borderWidth, p->drawable.depth, CREATE_PIXMAP_USAGE_BACKING_PIXMAP);
+}
+static Bool destroy_pixmap(PixmapPtr p) {
+    struct xwl_pixmap *a = xwl_pixmap_get(p);
+    if (a && p->refcnt == 1) {
+        struct xwl_screen *s = xwl_screen_get(p->drawable.pScreen);
+        xwl_pixmap_del_buffer_release_cb(p);
+        if (a->buffer) wl_buffer_destroy(a->buffer);
+        xwl_glamor_egl_make_current(s);
+        eglDestroyImageKHR(s->egl_display, a->image);
+        AHardwareBuffer_release(a->ahb);
+        if (a->export_fd >= 0) { xorg_list_del(&a->export_link); MATON_CLOSE(a->export_fd); }
+        free(a);
+    }
+    return glamor_destroy_pixmap(p);
+}
+static const struct wl_buffer_listener release_listener = { xwl_pixmap_buffer_release_cb };
+struct wl_buffer *xwl_glamor_pixmap_get_wl_buffer(PixmapPtr p) {
+    struct xwl_pixmap *a = xwl_pixmap_get(p);
+    struct xwl_screen *s = xwl_screen_get(p->drawable.pScreen);
+    if (!a) return NULL;
+    xwl_glamor_egl_make_current(s);
+    /* No acquire fence in maton-ahb-buffer-v1. Also covers Present flips. */
+    glFinish();
+    if (!a->buffer) {
+        int pair[2]; AHardwareBuffer_Desc d; AHardwareBuffer_describe(a->ahb, &d);
+        if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, pair)) return NULL;
+        if (!AHardwareBuffer_sendHandleToUnixSocket(a->ahb, pair[1])) { /* HAL 5 = BGRA = DRM ARGB8888 */
+            a->buffer = maton_ahb_buffer_manager_v1_create_buffer(get_ahb(s)->manager, pair[0], p->drawable.width,
+                p->drawable.height, d.format == 5 ? 0x34325241u /* AR24 */ : 0x34324241u /* AB24 */);
+        }
+        MATON_CLOSE(pair[0]); MATON_CLOSE(pair[1]);
+        if (a->buffer) wl_buffer_add_listener(a->buffer, &release_listener, p);
+    }
+    return a->buffer;
+}
+
+/* Metadata {width,height,AHB format,drawable,client-reserved pixmap XID} plus
+ * SCM_RIGHTS containing the already-filled AHB transport socket. All words
+ * are uint32_t in local byte order (the supported clients are x86 LE).
+ * Reply: pixmap XID, or zero. Present/FreePixmap remain ordinary X requests. */
+#define AHB_LOOKUP_MAGIC 0x4c48414du /* "MAHL" */
+#define AHB_REGISTER_MAGIC 0x5248414du /* "MAHR" */
+/* The AHB behind an exported fd: our DRI3 exports, then client registrations. */
+static AHardwareBuffer *find_export(struct ahb_screen *a, int fd) {
+    struct stat st;
+    struct xwl_pixmap *x;
+    struct import_peer *p;
+    if (fstat(fd, &st)) { ErrorF("maton-ahb: fstat fd=%d failed errno=%d\n", fd, errno); return NULL; }
+    xorg_list_for_each_entry(x, &a->exports, export_link)
+        if (x->dev == st.st_dev && x->ino == st.st_ino) return x->ahb;
+    xorg_list_for_each_entry(p, &a->peers, link)
+        if (p->ahb && p->dev == st.st_dev && p->ino == st.st_ino) return p->ahb;
+    return NULL;
+}
+static void drop_peer(struct import_peer *p) {
+    if (p->ahb) AHardwareBuffer_release(p->ahb);
+    if (p->export_fd >= 0) MATON_CLOSE(p->export_fd);
+    RemoveNotifyFd(p->fd); MATON_CLOSE(p->fd);
+    xorg_list_del(&p->link); free(p);
+}
+static void import_request(int fd, int events, void *data) {
+    struct import_peer *peer = data;
+    struct xwl_screen *s = peer->screen;
+    if (peer->ahb) {
+        /* A registration ends when its client closes the socket. */
+        ErrorF("maton-ahb: registration fd=%d ino=%lu ended\n", fd, (unsigned long)peer->ino);
+        drop_peer(peer);
+        return;
+    }
+    uint32_t req[5] = {0}, reply = 0;
+    struct iovec iov = { req, sizeof(req) };
+    /* Room for more than one fd so an unexpected count is seen and closed. */
+    union { struct cmsghdr align; char bytes[CMSG_SPACE(4 * sizeof(int))]; } control;
+    memset(&control, 0, sizeof(control));
+    struct msghdr msg = { .msg_iov=&iov, .msg_iovlen=1,
+        .msg_control=control.bytes, .msg_controllen=sizeof(control.bytes) };
+    int transport = -1, second = -1, extra = 0;
+    ssize_t n;
+    do n = recvmsg(fd, &msg, MSG_DONTWAIT | MSG_CMSG_CLOEXEC); while (n < 0 && errno == EINTR);
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return; /* spurious wakeup: keep the peer */
+    if (n < 0) { ErrorF("maton-ahb: recvmsg fd=%d failed errno=%d\n", fd, errno); goto done; }
+    /* Control data is valid only after a successful receive. Every delivered
+     * fd is ours, even on rejection or truncation. */
+    for (struct cmsghdr *cm = CMSG_FIRSTHDR(&msg); cm; cm = CMSG_NXTHDR(&msg, cm)) {
+        if (cm->cmsg_level != SOL_SOCKET || cm->cmsg_type != SCM_RIGHTS || cm->cmsg_len < CMSG_LEN(0)) continue;
+        size_t count = (cm->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+        for (size_t i = 0; i < count; i++) {
+            int got; memcpy(&got, CMSG_DATA(cm) + i * sizeof(int), sizeof(int));
+            if (transport < 0) transport = got;
+            else if (second < 0) second = got;
+            else { extra++; MATON_CLOSE(got); }
+        }
+    }
+    if (n == sizeof(uint32_t) && req[0] == AHB_REGISTER_MAGIC) {
+        /* Register {exported fd, filled AHB transport}; ack 1 and keep the peer. */
+        struct stat st;
+        AHardwareBuffer *ahb = NULL;
+        uint32_t ack = 1;
+        if (transport < 0 || second < 0 || extra) ErrorF("maton-ahb: register fd=%d: wrong fd count\n", fd);
+        else if (fstat(transport, &st)) ErrorF("maton-ahb: register fstat failed errno=%d\n", errno);
+        else if (AHardwareBuffer_recvHandleFromUnixSocket(second, &ahb)) ErrorF("maton-ahb: register recv AHB failed\n");
+        else if (send(fd, &ack, sizeof(ack), MSG_NOSIGNAL | MSG_DONTWAIT) != (ssize_t)sizeof(ack)) {
+            ErrorF("maton-ahb: register ack failed errno=%d\n", errno);
+            AHardwareBuffer_release(ahb);
+        } else {
+            peer->ahb = ahb; peer->export_fd = transport; peer->dev = st.st_dev; peer->ino = st.st_ino;
+            ErrorF("maton-ahb: registered client export ino=%lu\n", (unsigned long)st.st_ino);
+            MATON_CLOSE(second);
+            return;
+        }
+        if (second >= 0) MATON_CLOSE(second);
+        goto done;
+    }
+    if (second >= 0) { extra++; MATON_CLOSE(second); }
+    if (extra) ErrorF("maton-ahb: fd=%d sent %d unexpected extra fds\n", fd, extra);
+    if (n == sizeof(uint32_t) && req[0] == AHB_LOOKUP_MAGIC) {
+        /* Lookup: the fd is a DRI3 export; answer with its AHB or hang up. */
+        AHardwareBuffer *x = transport >= 0 && !extra ? find_export(get_ahb(s), transport) : NULL;
+        if (!x) ErrorF("maton-ahb: lookup fd=%d: not a live DRI3 export\n", transport);
+        else {
+            int r = AHardwareBuffer_sendHandleToUnixSocket(x, fd);
+            if (r) ErrorF("maton-ahb: lookup sendHandleToUnixSocket failed %d\n", r);
+        }
+        goto done;
+    }
+    if (n == sizeof(req) && !(msg.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) && transport >= 0 && !extra) {
+        unsigned index = CLIENT_ID(req[4]);
+        ClientPtr client = index < currentMaxClients ? clients[index] : NULL;
+        DrawablePtr drawable;
+        AHardwareBuffer *ahb = NULL;
+        int why = !client || client == serverClient ? 1 : !LegalNewID(req[4], client) ? 2 :
+            dixLookupDrawable(&drawable, req[3], client, M_DRAWABLE_WINDOW, DixWriteAccess) != Success ? 3 :
+            drawable->pScreen != s->screen ? 4 : drawable->depth != 24 && drawable->depth != 32 ? 5 :
+            AHardwareBuffer_recvHandleFromUnixSocket(transport, &ahb) ? 6 : 0;
+        if (why) ErrorF("maton-ahb: precheck %d depth=%d\n", why, why > 4 ? drawable->depth : -1);
+        if (!why) {
+            AHardwareBuffer_Desc d;
+            AHardwareBuffer_describe(ahb, &d);
+            ErrorF("maton-ahb: desc %ux%u layers=%u fmt=%u stride=%u\n", d.width, d.height, d.layers, d.format, d.stride);
+            if (d.width == req[0] && d.height == req[1] && d.layers == 1 &&
+                (req[2] == 1 || req[2] == 5) /* HAL RGBA/BGRA_8888 */ && d.format == req[2]) {
+                PixmapPtr p = import_ahb(s->screen, ahb, drawable->depth);
+                if (p) {
+                    p->drawable.id = req[4];
+                    /* Clients read it after our GL writes: fence it like DRI3 imports (publish_fences). */
+                    struct xwl_pixmap *xp = xwl_pixmap_get(p);
+                    const native_handle_t *h = AHardwareBuffer_getNativeHandle(xp->ahb);
+                    int m = h && h->numFds > 0 ? fcntl(h->data[0], F_DUPFD_CLOEXEC, 0) : -1;
+                    struct stat st;
+                    if (m < 0 || fstat(m, &st)) {
+                        ErrorF("maton-ahb: private import keep fd failed (fds=%d errno=%d); GL writes to it are unsynchronised\n",
+                               h ? h->numFds : -1, errno);
+                        if (m >= 0) MATON_CLOSE(m);
+                    } else {
+                        xp->export_fd = m; xp->dev = st.st_dev; xp->ino = st.st_ino;
+                        xorg_list_add(&xp->export_link, &get_ahb(s)->exports);
+                    }
+                    if (AddResource(req[4], RT_PIXMAP, p)) reply = req[4];
+                    else ErrorF("maton-ahb: AddResource xid=%#x failed\n", req[4]);
+                    /* AddResource destroys the pixmap on allocation failure. */
+                    ahb = NULL;
+                } else ErrorF("maton-ahb: import_ahb %ux%u failed\n", req[0], req[1]);
+            }
+            if (ahb) AHardwareBuffer_release(ahb);
+        }
+    }
+    if (!reply) ErrorF("maton-ahb: import rejected n=%d tr=%d extra=%d flags=%#x %ux%u fmt=%u win=%#x xid=%#x\n",
+                       (int)n, transport, extra, msg.msg_flags, req[0], req[1], req[2], req[3], req[4]);
+    {
+        ssize_t sent;
+        do sent = send(fd, &reply, sizeof(reply), MSG_NOSIGNAL | MSG_DONTWAIT); while (sent < 0 && errno == EINTR);
+        if (sent != (ssize_t)sizeof(reply)) {
+            ErrorF("maton-ahb: reply send fd=%d xid=%#x failed sent=%d errno=%d\n", fd, reply, (int)sent, sent < 0 ? errno : 0);
+            /* The client will not learn about the pixmap: do not leave it orphaned. */
+            if (reply) FreeResource(reply, RT_NONE);
+        }
+    }
+done:
+    if (transport >= 0) MATON_CLOSE(transport);
+    RemoveNotifyFd(fd); MATON_CLOSE(fd);
+    xorg_list_del(&peer->link); free(peer);
+}
+static void accept_import(int fd, int events, void *data) {
+    int peer = accept4(fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+    if (peer < 0) {
+        if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) ErrorF("maton-ahb: accept4 failed errno=%d\n", errno);
+        return;
+    }
+    struct xwl_screen *s = data;
+    struct import_peer *p = calloc(1, sizeof(*p));
+    if (!p) { ErrorF("maton-ahb: peer alloc failed\n"); MATON_CLOSE(peer); return; }
+    p->screen = s; p->fd = peer; p->export_fd = -1;
+    xorg_list_add(&p->link, &get_ahb(s)->peers);
+    if (!SetNotifyFd(peer, import_request, X_NOTIFY_READ, p)) {
+        ErrorF("maton-ahb: SetNotifyFd fd=%d failed\n", peer);
+        xorg_list_del(&p->link); free(p); MATON_CLOSE(peer);
+    }
+}
+static Bool close_screen(ScreenPtr screen) {
+    /* Runs after xwl_close_screen freed xwl_screen and disconnected Wayland. */
+    struct ahb_screen *a = dixLookupPrivate(&screen->devPrivates, &ahb_key);
+    struct import_peer *p, *next;
+    xorg_list_for_each_entry_safe(p, next, &a->peers, link) drop_peer(p);
+    RemoveNotifyFd(a->listener); MATON_CLOSE(a->listener); unlink(a->path); MATON_CLOSE(a->directory);
+    /* a->manager died with the Wayland display; destroying it locks a freed mutex. */
+    screen->CloseScreen = a->close_screen;
+    DeleteCallback(&FlushCallback, flush_callback, screen);
+    SyncScreenFuncsPtr funcs = miSyncGetScreenFuncs(screen);
+    if (funcs && funcs->CreateFence == create_fence) funcs->CreateFence = a->create_fence;
+    else if (funcs) ErrorF("maton-ahb: CreateFence wrapped above us at close; left in place\n");
+    free(a);
+    return screen->CloseScreen(screen);
+}
+Bool xwl_glamor_init_gbm(struct xwl_screen *s) {
+    if (!dixRegisterPrivateKey(&ahb_key, PRIVATE_SCREEN, 0)) return FALSE;
+    struct ahb_screen *a = calloc(1, sizeof(*a));
+    if (!a) return FALSE;
+    a->listener = a->directory = -1;
+    xorg_list_init(&a->peers);
+    xorg_list_init(&a->exports);
+    dixSetPrivate(&s->screen->devPrivates, &ahb_key, a);
+    return TRUE;
+}
+Bool xwl_glamor_gbm_init_egl(struct xwl_screen *s) {
+    const EGLint context_attrs[] = { EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE };
+    const EGLint config_attrs[] = { EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8, EGL_NONE };
+    EGLConfig config;
+    EGLint count;
+    s->egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (s->egl_display == EGL_NO_DISPLAY || !eglInitialize(s->egl_display, NULL, NULL) ||
+        !eglBindAPI(EGL_OPENGL_ES_API) ||
+        !eglChooseConfig(s->egl_display, config_attrs, &config, 1, &count) || count != 1) return FALSE;
+    s->egl_context = eglCreateContext(s->egl_display, config, EGL_NO_CONTEXT, context_attrs);
+    return s->egl_context != EGL_NO_CONTEXT &&
+        eglMakeCurrent(s->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, s->egl_context);
+}
+/* DRI3 1.0 over AHBs: BufferFromPixmap hands out the AHB's own first
+ * native-handle fd (whatever the gralloc uses, a dma-buf on GKI devices); its
+ * identity maps back to the AHB (the forwarder ICD looks it up over the AHB
+ * socket). PixmapFromBuffer accepts our exports and client-registered ones (MAHR).
+ * Open is refused: there is no DRM device. */
+static int dri3_refuse_open(ClientPtr client, ScreenPtr screen, RRProviderPtr provider, int *fd) {
+    ErrorF("maton-dri3: refused Open client=%d\n", client->index);
+    return BadMatch;
+}
+static PixmapPtr dri3_pixmap_from_fd(ScreenPtr screen, int fd, CARD16 w, CARD16 h, CARD16 stride, CARD8 depth, CARD8 bpp) {
+    AHardwareBuffer *ahb = find_export(get_ahb(xwl_screen_get(screen)), fd);
+    AHardwareBuffer_Desc d;
+    if (!ahb) {
+        char link[64], target[256]; struct stat st; ssize_t len;
+        snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+        len = readlink(link, target, sizeof(target) - 1);
+        target[len > 0 ? len : 0] = 0;
+        if (fstat(fd, &st)) memset(&st, 0, sizeof(st));
+        ErrorF("maton-dri3: refused PixmapFromBuffer %ux%u stride=%u depth=%u: not a known AHB export (fd -> '%s' mode=%#o dev=%#lx rdev=%#lx)\n",
+               w, h, stride, depth, target, (unsigned)st.st_mode, (unsigned long)st.st_dev, (unsigned long)st.st_rdev);
+        return NULL;
+    }
+    AHardwareBuffer_describe(ahb, &d);
+    /* The AHB carries its own layout; a client stride (e.g. from a LINEAR
+     * query the forwarder answered with OPTIMAL tiling) is advisory. */
+    if ((uint64_t)d.stride * 4 != stride)
+        ErrorF("maton-dri3: PixmapFromBuffer stride %u differs from AHB %u; using the AHB layout\n", stride, d.stride * 4);
+    if (d.width != w || d.height != h || bpp != 32 || (depth != 24 && depth != 32)) {
+        ErrorF("maton-dri3: refused PixmapFromBuffer %ux%u stride=%u depth=%u bpp=%u: AHB is %ux%u stride=%u\n",
+               w, h, stride, depth, bpp, d.width, d.height, d.stride * 4);
+        return NULL;
+    }
+    AHardwareBuffer_acquire(ahb);
+    PixmapPtr p = import_ahb(screen, ahb, depth);
+    if (!p) { ErrorF("maton-dri3: PixmapFromBuffer import failed\n"); AHardwareBuffer_release(ahb); return NULL; }
+    /* Shared with the client: our GL writes to it get fenced (publish_fences). */
+    struct xwl_pixmap *a = xwl_pixmap_get(p);
+    struct stat st;
+    int m = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+    if (m < 0 || fstat(m, &st)) {
+        ErrorF("maton-dri3: PixmapFromBuffer keep fd failed errno=%d; GL writes to it are unsynchronised\n", errno);
+        if (m >= 0) MATON_CLOSE(m);
+        return p;
+    }
+    a->export_fd = m; a->dev = st.st_dev; a->ino = st.st_ino;
+    xorg_list_add(&a->export_link, &get_ahb(xwl_screen_get(screen))->exports);
+    return p;
+}
+static int dri3_fd_from_pixmap(ScreenPtr screen, PixmapPtr pixmap, CARD16 *stride, CARD32 *size) {
+    struct xwl_pixmap *a = xwl_pixmap_get(pixmap);
+    if (!a || !a->ahb) {
+        ErrorF("maton-dri3: refused BufferFromPixmap %ux%u depth=%u: not AHB-backed\n",
+               pixmap->drawable.width, pixmap->drawable.height, pixmap->drawable.depth);
+        return -1;
+    }
+    AHardwareBuffer_Desc d;
+    AHardwareBuffer_describe(a->ahb, &d);
+    uint64_t bytes = (uint64_t)d.stride * 4;
+    if (bytes > UINT16_MAX || bytes * d.height > UINT32_MAX) {
+        ErrorF("maton-dri3: refused BufferFromPixmap: stride %u too large for DRI3 1.0\n", d.stride);
+        return -1;
+    }
+    if (a->export_fd < 0) {
+        struct stat st;
+        const native_handle_t *h = AHardwareBuffer_getNativeHandle(a->ahb);
+        if (!h || h->numFds < 1) {
+            ErrorF("maton-dri3: refused BufferFromPixmap %ux%u: AHB native handle has no fd (handle=%p fds=%d)\n",
+                   d.width, d.height, (void *) h, h ? h->numFds : -1);
+            return -1;
+        }
+        int m = fcntl(h->data[0], F_DUPFD_CLOEXEC, 0);
+        if (m < 0) { ErrorF("maton-dri3: dup native-handle fd failed errno=%d\n", errno); return -1; }
+        if (fstat(m, &st)) {
+            ErrorF("maton-dri3: fstat native-handle fd failed errno=%d\n", errno); MATON_CLOSE(m); return -1;
+        }
+        a->export_fd = m; a->dev = st.st_dev; a->ino = st.st_ino;
+        xorg_list_add(&a->export_link, &get_ahb(xwl_screen_get(screen))->exports);
+    }
+    /* The DRI3 request handler sends and closes the returned fd. */
+    int fd = fcntl(a->export_fd, F_DUPFD_CLOEXEC, 0);
+    if (fd < 0) { ErrorF("maton-dri3: dup export failed errno=%d\n", errno); return -1; }
+    *stride = (CARD16)bytes;
+    *size = (CARD32)(bytes * d.height);
+    ErrorF("maton-dri3: BufferFromPixmap %ux%u depth=%u fd=%d stride=%u ino=%lu\n",
+           d.width, d.height, pixmap->drawable.depth, fd, (unsigned)bytes, (unsigned long)a->ino);
+    return fd;
+}
+static const dri3_screen_info_rec dri3_refuse_info = {
+    .version = 1,
+    .open_client = dri3_refuse_open,
+    .pixmap_from_fd = dri3_pixmap_from_fd,
+    .fd_from_pixmap = dri3_fd_from_pixmap,
+};
+Bool xwl_glamor_gbm_init_screen(struct xwl_screen *s) {
+    struct ahb_screen *a = get_ahb(s);
+    const char *dir = getenv("MATON_X11_AHB_DIR");
+    struct sockaddr_un address = { .sun_family=AF_UNIX };
+    if (!dir) return FALSE;
+    a->directory = open(dir, O_PATH | O_DIRECTORY | O_CLOEXEC);
+    if (a->directory < 0) return FALSE;
+    int len = snprintf(a->path, sizeof(a->path), "/proc/self/fd/%d/X%s.ahb", a->directory, display);
+    if (len < 0 || len >= sizeof(a->path)) { MATON_CLOSE(a->directory); return FALSE; }
+    strcpy(address.sun_path, a->path);
+    a->listener = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (a->listener < 0) { MATON_CLOSE(a->directory); return FALSE; }
+    unlink(a->path);
+    if (bind(a->listener, (struct sockaddr *)&address, sizeof(address)) || listen(a->listener, 16) ||
+        !SetNotifyFd(a->listener, accept_import, X_NOTIFY_READ, s)) {
+        MATON_CLOSE(a->listener); a->listener = -1; unlink(a->path); MATON_CLOSE(a->directory); return FALSE;
+    }
+    s->screen->CreatePixmap = create_pixmap;
+    s->screen->DestroyPixmap = destroy_pixmap;
+    a->close_screen = s->screen->CloseScreen;
+    s->screen->CloseScreen = close_screen;
+    if (!epoxy_has_egl_extension(s->egl_display, "EGL_ANDROID_native_fence_sync")) {
+        ErrorF("maton-ahb: EGL_ANDROID_native_fence_sync missing: cannot fence shared buffers\n");
+        return FALSE;
+    }
+    SyncScreenFuncsPtr funcs = miSyncGetScreenFuncs(s->screen);
+    if (!funcs || !dixRegisterPrivateKey(&fence_key, PRIVATE_SYNC_FENCE, sizeof(SyncFenceSetTriggeredFunc)) ||
+        !AddCallback(&FlushCallback, flush_callback, s->screen)) {
+        ErrorF("maton-ahb: sync/flush hooks unavailable: cannot fence shared buffers\n");
+        return FALSE;
+    }
+    a->create_fence = funcs->CreateFence;
+    funcs->CreateFence = create_fence;
+    if (!dri3_screen_init(s->screen, &dri3_refuse_info)) {
+        ErrorF("maton-dri3: dri3_screen_init failed\n");
+        return FALSE;
+    }
+    return TRUE;
+}
--- /dev/null
+++ b/hw/xwayland/maton-ahb-buffer-v1.xml
@@ -0,0 +1,16 @@
+<protocol name="maton_ahb_buffer_v1">
+  <interface name="maton_ahb_buffer_manager_v1" version="1">
+    <description summary="create wl_buffers backed directly by Android hardware buffers">
+      This private protocol transports an AHardwareBuffer over an AF_UNIX
+      socket and creates a zero-copy wl_buffer for the received allocation.
+    </description>
+    <request name="destroy" type="destructor"/>
+    <request name="create_buffer">
+      <arg name="id" type="new_id" interface="wl_buffer"/>
+      <arg name="transport" type="fd"/>
+      <arg name="width" type="uint"/>
+      <arg name="height" type="uint"/>
+      <arg name="format" type="uint"/>
+    </request>
+  </interface>
+</protocol>
